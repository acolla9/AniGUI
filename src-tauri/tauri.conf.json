{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniGUI",
  "version": "0.1.0",
  "identifier": "dev.anigui.gui",
  "build": {
    "beforeDevCommand": "node scripts/fetch-mpv.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-mpv.mjs --require && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AniGUI",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Anime browsing and playback desktop app",
    "longDescription": "A Windows desktop GUI for an ani-cli-inspired anime workflow.",
    "category": "Entertainment",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/mpv/**/*"
    ]
  }
}
