{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GravityAnime",
  "version": "0.1.0",
  "identifier": "com.gravityanime.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GravityAnime",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Anime browsing and playback desktop app",
    "longDescription": "A modern desktop GUI for streaming anime.",
    "category": "Entertainment",
    "windows": { "nsis": { "displayLanguageSelector": false, "installMode": "currentUser" } }
  }
}
